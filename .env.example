# Copy to .env and fill in real values. Never commit .env itself.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=pathfinder.settings.prod

# Database (used by both the db service and Django's DATABASE_URL)
POSTGRES_DB=pathfinder
POSTGRES_USER=pathfinder
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://pathfinder:change-me@db:5432/pathfinder
