# Copy to .env and fill in real values. Never commit .env itself.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=pathfinder.settings.prod

# Database (used by both the db service and Django's DATABASE_URL)
POSTGRES_DB=pathfinder
POSTGRES_USER=pathfinder
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://pathfinder:change-me@db:5432/pathfinder

# Email for email-method alerts. REQUIRED to actually send alert emails in prod:
# EMAIL_HOST, EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, DEFAULT_FROM_EMAIL.
# If EMAIL_HOST is unset, prod still starts but only logs alert emails. See README: Deployment settings.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=change-me
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=alerts@example.com
